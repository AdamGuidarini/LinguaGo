{
  "name": "lingua-go",
  "version": "0.1.4",
  "scripts": {
    "build:background": "esbuild src/extension-actions/background.ts --bundle --minify --format=iife --target=firefox115 --outfile=dist/lingua-go/browser/extension-actions/background.js",
    "build": "ng build --aot && yarn build:background && cp ./src/metadata.json ./dist/lingua-go/browser && npx web-ext build -s ./dist/lingua-go/browser -o",
    "start": "web-ext run -t firefox-desktop --devtools -s ./dist/lingua-go/browser",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "ng lint",
    "clean": "rm -r dist",
    "package": "cd dist/lingua-go/browser && zip -r -FS ../../../linguago.$npm_package_version.zip . -x '*.map'",
    "package:source": "zip -r -FS ./linguago-source.$npm_package_version.zip . -x '*.git*' 'node_modules/*' 'dist/*' 'coverage/*' 'web-ext-artifacts/*' '*.zip'"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@jsverse/transloco": "^8.4.0",
    "google-translate-api-x": "^10.7.2",
    "luxon": "^3.7.1",
    "primeicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@hirez_io/observer-spy": "^2.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.15",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "esbuild": "0.20.1",
    "eslint": "^10.0.1",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1",
    "web-ext": "^8.8.0",
    "webextension-polyfill": "^0.12.0"
  }
}
